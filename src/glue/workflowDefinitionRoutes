/**
 * Workflow definition routes for the Valtaris Glue control plane.
 * Provides deterministic route registration for loading and saving
 * workflow definitions.
 */

import { router } from "../server/router";
import { WorkflowDefinitionController } from "./workflowDefinitionController";

const controller = new WorkflowDefinitionController();

// Load workflow definition
router.register({
  path: "/workflow/definition/load",
  method: "GET",
  handler: async (ctx, req) => {
    return controller.load(ctx, req);
  }
});

// Save workflow definition (creates new version)
router.register({
  path: "/workflow/definition/save",
  method: "POST",
  handler: async (ctx, req) => {
    return controller.save(ctx, req);
  }
});
