/**
 * integrationRegistry.ts
 *
 * Central registry of all integrated subsystems (arms) in the Valtaris ecosystem.
 *
 * Nucleus = head
 * Arms    = Glue, Decision Weaver, Guardian, DualPay, etc.
 */

export type IntegratedSubsystemId =
  | "glue"
  | "decision-weaver"
  | "guardian"
  | "dualpay";

export interface IntegratedSubsystem {
  id: IntegratedSubsystemId;
  displayName: string;
  description: string;
  docsUrl?: string;
  repoUrl?: string;
  enabled: boolean;
}

export const integratedSubsystems: IntegratedSubsystem[] = [
  {
    id: "glue",
    displayName: "Glue (Workflow Engine)",
    description: "Deterministic workflow orchestration and authoring.",
    repoUrl: "https://github.com/gmr9387/valtaris-nucleus",
    enabled: true
  },
  {
    id: "decision-weaver",
    displayName: "Decision Weaver (Decision Intelligence)",
    description: "Deterministic decision engine, simulation lab, and governance.",
    repoUrl: "https://github.com/gmr9387/decision-weaver-ai",
    enabled: true
  },
  {
    id: "guardian",
    displayName: "Guardian (Risk & Governance)",
    description: "Rules, risk scoring, and operational governance.",
    enabled: true
  },
  {
    id: "dualpay",
    displayName: "DualPay (Payments & Ledgering)",
    description: "Multi-rail payments, ledgering, and reconciliation.",
    enabled: true
  }
];

/**
 * Simple lookup helpers.
 */

export function getSubsystem(id: IntegratedSubsystemId) {
  return integratedSubsystems.find(s => s.id === id) ?? null;
}

export function listSubsystems() {
  return integratedSubsystems;
}
