/**
 * eventBus.ts
 *
 * Nucleus Event Bus
 *
 * Swap 28: Bind event publishing to Supabase RPC layer.
 */

import { logEvent } from "./supabase/rpc/logEvent";

export interface NucleusEvent {
  id: string;
  source: string;
  type: string;
  context: any;
  payload: any;
  timestamp: string;
}

export const eventBus = {
  async publishEvent(event: NucleusEvent) {
    try {
      // Persist event via Supabase RPC
      await logEvent(event);

      // (Optional future swaps)
      // - in-memory listeners
      // - websocket broadcast
      // - distributed event routing

      return { status: "ok" };
    } catch (err: any) {
      console.error("Failed to publish event:", err);
      throw err;
    }
  }
};
