// Full file swap — Nucleus constitutional API

import { NucleusDBBridge } from "../db/nucleusDbBridge";

export class NucleusApi {
  private db = new NucleusDBBridge();
  private lineageChain: any[] = [];

  constructor(private subsystem: string, private organizationId: string) {}

  emit(name: string, version: string, payload: any) {
    const table = this.mapTable(name);

    // Persist contract
    this.db.insertContract(table, this.organizationId, version, payload);

    // Persist event
    this.db.insertEvent(
      this.organizationId,
      this.subsystem,
      name,
      version,
      payload
    );

    // Update in-memory lineage
    this.lineageChain.push({
      subsystem: this.subsystem,
      name,
      version,
      payload,
      at: Date.now(),
    });
  }

  finalize() {
    this.db.insertLineage(this.organizationId, this.lineageChain, true);
    return { ok: true, chain: this.lineageChain };
  }

  lineage() {
    return { chain: this.lineageChain };
  }

  private mapTable(name: string): string {
    switch (name) {
      case "opportunity":
        return "opportunity";
      case "recommendation":
        return "recommendation";
      case "authorization":
        return "authorization_contract";
      case "execution":
        return "execution";
      case "payment":
        return "payment";
      default:
        throw new Error(`Unknown contract name: ${name}`);
    }
  }
}
