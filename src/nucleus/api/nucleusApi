// src/nucleus/api/nucleusApi.ts

/**
 * NucleusApi (Phase 6)
 *
 * Purpose:
 *   Public constitutional API surface for:
 *     - emitting contracts
 *     - running sessions
 *     - retrieving lineage
 *     - finalizing runs
 *     - inspecting deterministic state
 */

import { NucleusSession } from "../runtime/nucleusSession";
import { eventBus } from "../events/eventBus";

export class NucleusApi {
  private session: NucleusSession;

  constructor(
    subsystem: "weaver" | "guardian" | "glue" | "dualpay",
    organizationId: string
  ) {
    this.session = new NucleusSession(subsystem, organizationId);
  }

  /**
   * Emit a contract into the constitutional runtime.
   * This is the ONLY public entrypoint for contract emission.
   */
  emit(name: string, version: string, payload: any) {
    // Record contract snapshot BEFORE routing
    this.session.state.record(name, version, payload);

    // Emit into eventBus → runtimeHook → runtimeRouter → subsystemRuntime
    eventBus.emit("contract.emit", { name, version, payload });

    return { ok: true };
  }

  /**
   * Retrieve the last emitted contract of a given type.
   */
  last(name: string) {
    return this.session.state.last(name);
  }

  /**
   * Retrieve full constitutional lineage.
   */
  lineage() {
    return {
      opportunity: this.session.state.last("opportunity"),
      recommendation: this.session.state.last("recommendation"),
      authorization: this.session.state.last("authorization"),
      execution: this.session.state.last("execution"),
      payment: this.session.state.last("payment"),
    };
  }

  /**
   * Finalize the constitutional run.
   */
  finalize() {
    return this.session.finalization.finalizeRun();
  }

  /**
   * Expose underlying session (rarely needed).
   */
  getSession() {
    return this.session;
  }
}
