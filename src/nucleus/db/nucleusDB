// src/nucleus/db/nucleusDB.ts

/**
 * NucleusDB (Phase 13.1)
 *
 * Purpose:
 *   Provide a lightweight Supabase client wrapper for:
 *     - contract inserts
 *     - lineage queries
 *     - RLS-safe operations
 */

import { createClient, SupabaseClient } from "@supabase/supabase-js";

export class NucleusDB {
  private client: SupabaseClient;

  constructor(private url: string, private key: string) {
    this.client = createClient(url, key);
  }

  insert(table: string, payload: any) {
    return this.client.from(table).insert(payload);
  }

  select(table: string, filters: Record<string, any>) {
    let query = this.client.from(table).select("*");
    for (const key of Object.keys(filters)) {
      query = query.eq(key, filters[key]);
    }
    return query;
  }
}
