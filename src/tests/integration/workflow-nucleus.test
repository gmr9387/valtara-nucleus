import { describe, it, expect } from "vitest";
import { NucleusWorkflowAdapter } from "../../nucleus/workflows/nucleusWorkflowAdapter";

describe("Workflow → Nucleus integration", () => {
  it("routes workflow steps through Nucleus", async () => {
    const adapter = new NucleusWorkflowAdapter(
      "org-1",
      process.env.SUPABASE_URL || "http://localhost",
      process.env.SUPABASE_KEY || "test-key"
    );

    const events = [
      { type: "opportunity", version: "v1", payload: { organizationId: "org-1" } },
      { type: "recommendation", version: "v1", payload: { organizationId: "org-1" } },
      { type: "authorization", version: "v1", payload: { organizationId: "org-1" } },
      { type: "execution", version: "v1", payload: { organizationId: "org-1" } },
      { type: "payment", version: "v1", payload: { organizationId: "org-1" } },
    ];

    for (const event of events) {
      const lineage = await adapter.handleWorkflowEvent(event);
      expect(lineage).toBeDefined();
    }
  });
});
