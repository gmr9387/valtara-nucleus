import { describe, it, expect } from "vitest";
import { NucleusApi } from "../../nucleus/api/nucleusApi";

describe("Nucleus lineage", () => {
  it("builds correct lineage across subsystems", () => {
    const api = new NucleusApi("weaver", "org-1");

    api.emit("opportunity", "v1", { organizationId: "org-1" });
    api.emit("recommendation", "v1", { organizationId: "org-1" });
    api.emit("authorization", "v1", { organizationId: "org-1" });
    api.emit("execution", "v1", { organizationId: "org-1" });
    api.emit("payment", "v1", { organizationId: "org-1" });

    const lineage = api.lineage();

    expect(lineage).toBeDefined();
    expect(lineage.chain.length).toBe(5);
    expect(lineage.chain.map((c) => c.name)).toEqual([
      "opportunity",
      "recommendation",
      "authorization",
      "execution",
      "payment",
    ]);
  });
});
